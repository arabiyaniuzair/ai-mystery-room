PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key

# Google Gemini API Keys Configuration
# Primary Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Additional Gemini API Keys for automatic rotation & 429 quota exhaustion failover:
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4

# Alternative: Comma-separated list of keys
# GEMINI_API_KEYS=key1,key2,key3,key4,key5

# Optional: Cooldown duration in milliseconds when a key hits quota limit (default: 60000ms / 1 min)
# GEMINI_KEY_COOLDOWN_MS=60000

CLIENT_URL=http://localhost:5173
